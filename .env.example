# .env.example
# Copy this file to .env and replace placeholders with real values.
# Do NOT commit the real .env with secrets to version control.
#
# Use `openssl rand -hex 32` or other secret generator for secret keys.

## Database (PostgreSQL) connection string - format:
## postgresql://user:password@host:port/dbname?sslmode=disable
DB_SOURCE=postgresql://DB_USER:DB_PASSWORD@DB_HOST:6432/DB_NAME?sslmode=disable

# Server address where the app binds
SERVER_ADDRESS=0.0.0.0:8080

# JWT / token secrets and durations
# Use long random strings for secret keys (e.g., openssl rand -hex 32)
ACCESS_TOKEN_SECRET_KEY=replace_with_access_token_secret
ACCESS_TOKEN_DURATION=900s
REFRESH_TOKEN_SECRET_KEY=replace_with_refresh_token_secret
REFRESH_TOKEN_DURATION=24h

# Two-factor auth token
TWO_FA_TOKEN_SECRET_KEY=replace_with_2fa_token_secret
TWO_FA_TOKEN_DURATION=360s

# Backblaze B2 / S3 endpoint and credentials
B2_ENDPOINT=replace-with-b2-endpoint  # e.g. s3.eu-central-003.backblazeb2.com
B2_KEY=replace_with_b2_key
B2_KEY_ID=replace_with_b2_key_id
B2_BUCKET=replace_with_b2_bucket

# Host for constructing URLs (no scheme - used for links and redirects)
HOST=localhost:8080

# Redis connection (host:port) and password
REDIS_HOST=127.0.0.1:6379
REDIS_PASSWORD=replace_with_redis_password

# Remote mode - true/false (used to decide remote/local behavior)
REMOTE=false

# Open Router / external API key
OPEN_ROUTER_API_KEY=replace_with_open_router_api_key

# SMTP configuration for sending emails
SMTP_NAME=MyApp
SMTP_ADDRESS=dev@example.com
# SMTP authentication secret (e.g. password or API key)
SMTP_AUTH=replace_with_smtp_auth
SMTP_HOST=smtp.example.com
SMTP_PORT=465

# Brevo (Sendinblue) optional settings
BREVO_SENDER_NAME=MyApp
BREVO_SENDER_EMAIL=contact@example.com
BREVO_API_KEY=replace_with_brevo_api_key

# Application environment: development, staging, production, etc.
ENVIRONMENT=development

# gRPC server URL used by this service (host:port)
GRPC_URL=127.0.0.1:60051

# Migrations path (file:// or other supported scheme)
MIGRATIONS_PATH=file://db/migrations

# Optional: additional feature flags and secrets used by the app
# Add additional environment variables here as needed by your deployment

# Notes:
# - Replace placeholders with real values before starting the app.
# - Keep secret keys safe and rotate them if compromised.
# - Some variables accept multiple formats; check the application docs.
