# .env.example
# Copy this file to app.env or .env and replace placeholders with real values.
# Do NOT commit the real app.env with secrets to version control.

# Database (PostgreSQL) connection string
# For Docker Compose: postgres://maicare:maicare@db:5432/maicare?sslmode=disable
# For Local Postgres: postgres://maicare:maicare@localhost:5432/maicare?sslmode=disable
DB_SOURCE=postgres://maicare:maicare@db:5432/maicare?sslmode=disable

# Server address where the app binds
SERVER_ADDRESS=0.0.0.0:8080

# JWT / token secrets and durations
ACCESS_TOKEN_SECRET_KEY=replace_with_access_token_secret
ACCESS_TOKEN_DURATION=900s
REFRESH_TOKEN_SECRET_KEY=replace_with_refresh_token_secret
REFRESH_TOKEN_DURATION=24h

# Two-factor auth token
TWO_FA_TOKEN_SECRET_KEY=replace_with_2fa_token_secret
TWO_FA_TOKEN_DURATION=360s

# Backblaze B2 / S3 endpoint and credentials
B2_ENDPOINT=replace-with-b2-endpoint
B2_KEY=replace_with_b2_key
B2_KEY_ID=replace_with_b2_key_id
B2_BUCKET=replace_with_b2_bucket
DISABLE_BUCKET=true

# Host for constructing URLs (no scheme - used for links and redirects)
HOST=localhost:8080

# Redis connection (host:port) and password
REDIS_HOST=redis:6379
REDIS_PASSWORD=

# Remote mode - true/false (used to decide remote/local behavior)
REMOTE=false

# Open Router / external API key and model
OPEN_ROUTER_API_KEY=replace_with_open_router_api_key
OPEN_ROUTER_MODEL=openai/gpt-4o-mini

# SMTP configuration for sending emails
SMTP_NAME=MyApp
SMTP_ADDRESS=dev@example.com
SMTP_AUTH=replace_with_smtp_auth
SMTP_HOST=smtp.example.com
SMTP_PORT=465

# Brevo (Sendinblue) settings
BREVO_SENDER_NAME=MyApp
BREVO_SENDER_EMAIL=contact@example.com
BREVO_API_KEY=replace_with_brevo_api_key

# Application environment: development, staging, production, etc.
ENVIRONMENT=development

# gRPC server URL used by this service (host:port)
GRPC_URL=127.0.0.1:60051

# Migrations path
MIGRATIONS_PATH=file://db/migrations

# Admin Seed Credentials
ADMIN_EMAIL=admin@maicare.nl
ADMIN_PASSWORD=AdminPassword123!

# WebSocket Configuration
WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
WS_TICKET_TTL=1m
